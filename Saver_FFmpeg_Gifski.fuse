-- ============================================================================
-- Codec presets & encoder tables
-- ============================================================================

local function isTwoPassCodec(codec)
    return codec == "h264" or codec == "h265" or codec == "vp9" or codec == "av1" or codec == "avif"
end

local function isAv1FamilyCodec(codec)
    return codec == "av1" or codec == "avif"
end

local PRESET_DEFINITIONS = {
  {
    codec = "h264",
    name = "MP4 (H.264)",
    outputExtension = ".mp4",
    commandTemplate = 'ffmpeg -y -framerate ${CompFramerate} -start_number ${StartFrame} -i "${SequencePattern}" ${BackgroundInputArg} -frames:v ${FrameCount} -c:v libx264 ${RateControlArg} ${PresetArg} ${ProfileArg} ${TuneArg} -g ${S:KeyframeInterval} -pix_fmt ${PixelFormat} ${FastStartArg} ${AlphaFlattenFilterArg} ${TwoPassArg} ${OutputFramerateArg} "${OutputVideoPath}"',
  },
  {
    codec = "h265",
    name = "MP4 (H.265/HEVC)",
    outputExtension = ".mp4",
    commandTemplate = 'ffmpeg -y -framerate ${CompFramerate} -start_number ${StartFrame} -i "${SequencePattern}" ${BackgroundInputArg} -frames:v ${FrameCount} -c:v libx265 -tag:v hvc1 ${RateControlArg} ${PresetArg} ${ProfileArg} ${TuneArg} -g ${S:KeyframeInterval} -pix_fmt ${PixelFormat} ${FastStartArg} ${AlphaFlattenFilterArg} ${TwoPassArg} ${OutputFramerateArg} "${OutputVideoPath}"',
  },
  {
    codec = "av1",
    name = "MP4 (AV1)",
    outputExtension = ".mp4",
    commandTemplate = 'ffmpeg -y -framerate ${CompFramerate} -start_number ${StartFrame} -i "${SequencePattern}" ${BackgroundInputArg} -frames:v ${FrameCount} -c:v libaom-av1 ${RateControlArg} ${PresetArg} ${ProfileArg} ${TuneArg} -g ${S:KeyframeInterval} -pix_fmt ${PixelFormat} ${FastStartArg} ${AlphaFlattenFilterArg} ${TwoPassArg} ${OutputFramerateArg} "${OutputVideoPath}"',
  },
  {
    codec = "vp9",
    name = "WebM (VP9)",
    outputExtension = ".webm",
    commandTemplate = 'ffmpeg -y -framerate ${CompFramerate} -start_number ${StartFrame} -i "${SequencePattern}" ${BackgroundInputArg} -frames:v ${FrameCount} -c:v libvpx-vp9 ${RateControlArg} ${PresetArg} -g ${S:KeyframeInterval} -pix_fmt ${PixelFormat} ${AlphaFlattenFilterArg} ${TwoPassArg} ${OutputFramerateArg} "${OutputVideoPath}"',
  },
  {
    codec = "gif",
    name = "GIF",
    outputExtension = ".gif",
    commandTemplate = 'ffmpeg -y -framerate ${CompFramerate} -start_number ${StartFrame} -i "${SequencePattern}" -frames:v ${FrameCount} ${GifFilterComplexArg} ${OutputFramerateArg} "${OutputVideoPath}"',
  },
  {
    codec = "gif_gifski",
    name = "GIF (Gifski)",
    outputExtension = ".gif",
    commandTemplate = '@gifski -o "${OutputVideoPath}" -r ${CompFramerate} -Q ${S:GifskiQuality} ${GifskiFlags} --repeat ${S:GifskiRepeat} ${GifskiWidthArg} ${GifskiHeightArg} "${SequencePattern}"',
  },
  {
    codec = "webp",
    name = "WebP (Animated)",
    outputExtension = ".webp",
    commandTemplate = 'ffmpeg -y -framerate ${CompFramerate} -start_number ${StartFrame} -i "${SequencePattern}" -frames:v ${FrameCount} -c:v libwebp_anim ${WebPEncoderArgs} -loop 0 ${WebPFilterArg} ${OutputFramerateArg} "${OutputVideoPath}"',
  },
  {
    codec = "apng",
    name = "APNG (Animated PNG)",
    outputExtension = ".png",
    commandTemplate = 'ffmpeg -y -framerate ${CompFramerate} -start_number ${StartFrame} -i "${SequencePattern}" -frames:v ${FrameCount} -c:v apng -plays 0 ${ApngEncoderArgs} -f apng ${OutputFramerateArg} "${OutputVideoPath}"',
  },
  {
    codec = "avif",
    name = "AVIF",
    outputExtension = ".avif",
    commandTemplate = 'ffmpeg -y -framerate ${CompFramerate} -start_number ${StartFrame} -i "${SequencePattern}" ${BackgroundInputArg} -frames:v ${FrameCount} -c:v libaom-av1 ${RateControlArg} ${PresetArg} -g ${S:KeyframeInterval} -pix_fmt yuv420p ${FastStartArg} ${TwoPassArg} ${OutputFramerateArg} "${OutputVideoPath}"',
  },
  {
    codec = "prores",
    name = "QuickTime ProRes",
    outputExtension = ".mov",
    commandTemplate = 'ffmpeg -y -framerate ${CompFramerate} -start_number ${StartFrame} -i "${SequencePattern}" -frames:v ${FrameCount} ${AlphaFlattenFilterArg} ${OutputFramerateArg} -c:v prores_ks ${ProResProfileArg} -pix_fmt ${ProResPixFmt} -vendor apl0 "${OutputVideoPath}"',
  },
  {
    codec = "png_sequence",
    name = "PNG Sequence",
    outputExtension = ".png",
    commandTemplate = "",
  },

}

