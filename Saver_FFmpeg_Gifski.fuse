-- ============================================================================
-- Fuse callbacks
-- ============================================================================

function OnAddToFlow()
  -- Auto-fill frame rate: if the slider is 0, default to comp frame rate
  if InFramerate then
    local currentFps = getCompFrameRate(self.Comp)
    local sliderVal = InFramerate:GetSource(0).Value or 0
    if sliderVal <= 0 and currentFps > 0 then
      InFramerate:SetSource(Number(currentFps), 0, 0)
      InFramerate:SetAttrs({INP_Default = currentFps})

      fuseLog("[OnAddToFlow] Frame rate was 0, defaulted to comp rate:", currentFps)
    end
  end

  -- Auto-fill width/height from comp default resolution, but only if
  -- the user hasn't already set a non-zero value (preserves TIME_UNDEFINED
  -- settings from scripts or tool defaults).  Never use SetSource at time 0
  -- because that creates a keyframe that overrides TIME_UNDEFINED values.
  if InWidth and InHeight then
    local comp = self.Comp
    if comp then
      local compW = comp:GetPrefs("Comp.FrameFormat.Width")
      local compH = comp:GetPrefs("Comp.FrameFormat.Height")
      local curW = (InWidth:GetSource(0) or {}).Value or 0
      local curH = (InHeight:GetSource(0) or {}).Value or 0

      if compW and compW > 0 and curW <= 0 then
        InWidth:SetAttrs({ INP_Default = compW })
        InWidth:SetSource(Number(compW), 0, 0)
        fuseLog("[OnAddToFlow] Width defaulted to comp width:", compW)
      elseif compW and compW > 0 then
        InWidth:SetAttrs({ INP_Default = compW })
        fuseLog("[OnAddToFlow] Width set to", curW, "(kept user value, comp default:", compW, ")")
      end

      if compH and compH > 0 and curH <= 0 then
        InHeight:SetAttrs({ INP_Default = compH })
        InHeight:SetSource(Number(compH), 0, 0)
        fuseLog("[OnAddToFlow] Height defaulted to comp height:", compH)
      elseif compH and compH > 0 then
        InHeight:SetAttrs({ INP_Default = compH })
        fuseLog("[OnAddToFlow] Height set to", curH, "(kept user value, comp default:", compH, ")")
      end
    end
  end

  -- Refresh output file size and frame status on tool creation
  local outputValue = InOutputPath:GetSource(0)
  local outputPath = outputValue and outputValue.Value or ""
  if outputPath ~= "" then
    local mappedPath = self.Comp and self.Comp:MapPath(outputPath) or outputPath
    local basePath, ext = splitBaseAndExtension(mappedPath)
    refreshOutputFileSize(basePath, ext)
    refreshFrameStatus(basePath)
  end

  if FUSE_STARTUP_TESTS_ENABLED then
    fuseLog("[OnAddToFlow] FUSE_TESTS_ENABLED is set, running self-test...")

    local ok, err = pcall(Tests)
    if not ok then
      fuseLog("[TESTS] Tests crashed:", tostring(err))
    end
  end
end

function NotifyChanged(inp, param, time)
  if inp == InVersionFooter or inp == InLicenseFFmpeg or inp == InLicenseGifski then
    bmd.openurl(param.Value)
    inp:SetSource(Text(""), 0, 0)
    return
  end

  if inp == InTestsBtn and param.Value >= 0.5 then
    local ok, err = pcall(Tests)
    if not ok then
      fuseLog("[TESTS] Tests crashed:", tostring(err))
    end
    inp:SetSource(Number(0), 0, 0)
    return
  end

  if inp == InReloadBtn and param.Value >= 0.5 then
    local execute = string.format([[
      local tool = comp:FindTool("%s")
      if tool == nil then return end
      tool.ScriptReload[fu.TIME_UNDEFINED] = 1
      tool.ScriptReload[fu.TIME_UNDEFINED] = 0
    ]], self.Name)

    local ok, err = pcall(function()
      self.Comp:Execute(execute)
    end)

    if not ok then
      fuseLog("[ERROR] Reload failed:", tostring(err))
    end
    inp:SetSource(Number(0), 0, 0)
    return
  end

  if inp == InWebsiteBtn and param.Value >= 0.5 then
    bmd.openurl("https://tangenten.xyz")
    inp:SetSource(Number(0), 0, 0)
    return
  end

  if inp == InOutputPath then
    -- Refresh output file size and frame status when path changes
    local outputPath = param.Value or ""
    if outputPath ~= "" then
      local mappedPath = self.Comp and self.Comp:MapPath(outputPath) or outputPath
      local basePath, ext = splitBaseAndExtension(mappedPath)
      refreshOutputFileSize(basePath, ext)
      refreshFrameStatus(basePath)
    end
    return
  end

  if inp == InPreset then
    applyPresetTemplate(param.Value)
    return
  end

  if inp == InResolutionMode then
    local isManual = param.Value >= 0.5

    InScale:SetAttrs({ IC_Visible = not isManual })
    InWidth:SetAttrs({ IC_Visible = isManual })
    InHeight:SetAttrs({ IC_Visible = isManual })
    return
  end

  if inp == InRateControlMode then
    local modeIndex = math.floor(param.Value + 0.5) + 1
    local mode = RATE_CONTROL_MODE_OPTIONS[modeIndex] or RATE_CONTROL_MODE_OPTIONS[1]
    rcMode = mode
    local codecName = activePreset and activePreset.codec or "h264"
    local isRateControlCodec = codecName == "h264" or codecName == "h265" or codecName == "av1" or codecName == "vp9"
    local isH26x = codecName == "h264" or codecName == "h265"
    InCRF:SetAttrs({ IC_Visible = isRateControlCodec and mode == "CRF" })
    InMaxRateMbps:SetAttrs({ IC_Visible = isH26x and mode == "CRF" })
    InBufferSizeMbps:SetAttrs({ IC_Visible = isH26x and mode == "CRF" })
    InTargetBitrateMbps:SetAttrs({ IC_Visible = isRateControlCodec and (mode == "ABR" or mode == "CBR") })
    -- Two-pass is incompatible with CRF
    local isTwoPassCodec = codecName == "h264" or codecName == "h265" or codecName == "vp9" or codecName == "av1"
    if isTwoPassCodec and mode == "CRF" then
      InTwoPass:SetAttrs({ IC_Visible = false })
      InTwoPass:SetSource(Number(0), 0, 0)
    elseif isTwoPassCodec then
      InTwoPass:SetAttrs({ IC_Visible = true })
    end
    return
  end

  if inp == InVP9Alpha then
    vp9AlphaEnabled = param.Value >= 0.5
    local codecName = activePreset and activePreset.codec or "h264"
    if codecName == "vp9" then
      InPixelFormat:SetAttrs({ IC_Visible = param.Value < 0.5 })
    end
    return
  end

  if inp == InGifPaletteMode then
    local codecName = activePreset and activePreset.codec or "gif"
    if codecName == "gif" then
      local modeIndex = math.floor(param.Value + 0.5) + 1
      local mode = GIF_PALETTE_MODE_OPTIONS[modeIndex] or GIF_PALETTE_MODE_OPTIONS[1]
      InGifTwoPassPalette:SetAttrs({ IC_Visible = (mode == "single") })
    end
    return
  end

  if inp == InCommandTemplate then
    updateActiveSliderTokens(param.Value)
    return
  end

  if inp == InEncodeButton and param.Value >= 0.5 then
    InEncodeActive:SetSource(Number(1), 0, 0)
    inp:SetSource(Number(0), 0, 0)
    return
  end

  if inp == InClearFramesBtn and param.Value >= 0.5 then
    inp:SetSource(Number(0), 0, 0)
    local outputValue = InOutputPath:GetSource(0)
    local outputPath = outputValue and outputValue.Value or ""
    if outputPath ~= "" then
      local mappedPath = self.Comp and self.Comp:MapPath(outputPath) or outputPath
      local basePath, _ = splitBaseAndExtension(mappedPath)
      local msg = clearFrameFolder(basePath)
      fuseLog("[ClearFrames]", msg)
      -- Refresh frame status
      refreshFrameStatus(basePath)
    end
    return
  end

  if inp == InCancelBtn and param.Value >= 0.5 then
    inp:SetSource(Number(0), 0, 0)
    -- Store cancel flag via self:SetData for cross-callback visibility.
    -- Global variables are NOT shared between NotifyChanged and Process
    -- (they run in separate Lua states per tool instance).
    self:SetData("cancelRequested", true)
    fuseLog("[Cancel] Cancel requested by user")
    InProgressBar:SetAttrs({ LINKS_Name = buildProgressHtml(0, 0, 0, "Cancelling...") })
    return
  end
end

function Process(req)
  local img = InImage:GetValue(req)
  OutImage:Set(req, img)

  if InEncodeActive:GetValue(req).Value > 0.5 then
    InEncodeActive:SetSource(Number(0), 0, 0)
    self:SetData("cancelRequested", false)

    -- Refresh status before starting
    local outputValue = InOutputPath:GetValue(req)
    local outputPath = outputValue and outputValue.Value or ""
    if outputPath ~= "" then
      local mappedPath = self.Comp and self.Comp:MapPath(outputPath) or outputPath
      local basePath, ext = splitBaseAndExtension(mappedPath)
      refreshOutputFileSize(basePath, ext)
      refreshFrameStatus(basePath)
    end

    InExportingLabel:SetAttrs({ IC_Visible = true })

    local ok, renderErr = pcall(renderImageSequenceAndEncode, req)
    if not ok then
      fuseLog("[Process] render crashed:", tostring(renderErr))
      InProgressBar:SetAttrs({ LINKS_Name = buildProgressHtml(0, 0, 0, "ERROR: Render crashed") })
    else
      if isCancelRequested(self, req) then
        InProgressBar:SetAttrs({ LINKS_Name = buildProgressHtml(0, 0, 0, "Cancelled.") })
      else
        InProgressBar:SetAttrs({ LINKS_Name = buildProgressHtml(0, 0, 0) })
      end
    end

    -- Refresh status after export
    local outputValue2 = InOutputPath:GetValue(req)
    local outputPath2 = outputValue2 and outputValue2.Value or ""
    if outputPath2 ~= "" then
      local mappedPath2 = self.Comp and self.Comp:MapPath(outputPath2) or outputPath2
      local basePath2, ext2 = splitBaseAndExtension(mappedPath2)
      refreshOutputFileSize(basePath2, ext2)
      refreshFrameStatus(basePath2)
    end

    InExportingLabel:SetAttrs({ IC_Visible = false })
    self:SetData("cancelRequested", false)
  end

end

-- ============================================================================
-- Tests
-- ============================================================================

function Tests()
  local p, f = 0, 0
  local function ok(label, cond, detail)
    if cond then p = p + 1; fuseLog("[TEST OK]", label)
    else f = f + 1; fuseLog("[TEST FAIL]", label, detail or "")
    end
  end

  fuseLog("========== TEST START ==========")

  -- System / environment info
  local uname = runCommandFullBlocking("uname -a 2>&1") or "unavailable"
  local whichFF = runCommandFullBlocking("which ffmpeg 2>&1") or "not in PATH"
  local archInfo = jit and (jit.arch or "unknown") or "unknown"
  local luaVer = _VERSION or "unknown"
  local isJit = jit and "yes (" .. (jit.version or "?") .. ")" or "no"
  local isFusion = (self and self.Comp) and "yes" or "no"
  local ffPath = findFfmpegPath() or "not found"

  fuseLog("[sysinfo] IS_WINDOWS        =", tostring(IS_WINDOWS))
  fuseLog("[sysinfo] _VERSION          =", luaVer)
  fuseLog("[sysinfo] LuaJIT            =", isJit)
  fuseLog("[sysinfo] Fusion context    =", isFusion)
  fuseLog("[sysinfo] jit.arch          =", archInfo)
  fuseLog("[sysinfo] package.config    =", package.config:gsub("\n","\\n"))
  fuseLog("[sysinfo] uname -a          =", uname:gsub("%s+$",""))
  fuseLog("[sysinfo] which ffmpeg      =", whichFF:gsub("%s+$",""))
  fuseLog("[sysinfo] findFfmpegPath    =", ffPath)
  fuseLog("[sysinfo] PLUGIN_VERSION    =", PLUGIN_VERSION)

  -- —-- platform detection —--
  ok("IS_WINDOWS boolean", type(IS_WINDOWS) == "boolean")
  ok("package.config sep", package.config:sub(1,1) == "/" or package.config:sub(1,1) == "\\")

  -- —-- path helpers —--
  ok("NormalizePath empty", normalizePath("") == "")
  ok("NormalizePath plain", normalizePath("a/b") == (IS_WINDOWS and "a\\b" or "a/b"))
  local s = getPathSeparator()
  ok("GetPathSep matches IS_WINDOWS", (IS_WINDOWS and s == "\\") or (not IS_WINDOWS and s == "/"))
  ok("BuildFramePath png", buildFramePath("/p","/f",5,".png",true) == "/p_0005.png")
  ok("BuildFramePath enc", buildFramePath("/p","/f",5,".png",false) == "/f" .. s .. "0005.png")

  -- —-- getFrameWidth —--
  ok("getFrameWidth 0", getFrameWidth(0) == 4)    -- minimum 4
  ok("getFrameWidth 1", getFrameWidth(1) == 4)    -- minimum 4
  ok("getFrameWidth 9999", getFrameWidth(9999) == 4)  -- still 4 digits
  ok("getFrameWidth 10000", getFrameWidth(10000) == 5) -- 5 digits
  ok("getFrameWidth 99999", getFrameWidth(99999) == 5)
  ok("getFrameWidth 100000", getFrameWidth(100000) == 6)

  -- —-- buildFramePath with custom width —--
  ok("BuildFramePath width 5", buildFramePath("/p","/f",5,".png",true,5) == "/p_00005.png")
  ok("BuildFramePath width 6", buildFramePath("/p","/f",100000,".png",false,6) == "/f" .. s .. "100000.png")

  -- —-- IsValidShellPath —--
  ok("Valid nil", not isValidShellPath(nil))
  ok("Valid empty", not isValidShellPath(""))
  ok("Valid path", isValidShellPath("/home/user/file.png"))
  ok("Invalid $", not isValidShellPath("$(whoami)"))
  ok("Invalid backtick", not isValidShellPath("`id`"))
  ok("Invalid |", not isValidShellPath("x|y"))
  ok("Invalid ;", not isValidShellPath("x;y"))
  ok("Invalid \\n", not isValidShellPath("a\nb"))
  ok("Invalid backslash", not isValidShellPath("a\\b"))
  ok("Invalid double-quote", not isValidShellPath('a"b'))
  ok("Invalid bang", not isValidShellPath("a!b"))
  ok("Invalid ampersand", not isValidShellPath("a&b"))

  -- —-- codec helpers —--
  ok("TwoPass h264", isTwoPassCodec("h264"))
  ok("TwoPass vp9", isTwoPassCodec("vp9"))
  ok("TwoPass prores (false)", not isTwoPassCodec("prores"))
  ok("AV1 family av1", isAv1FamilyCodec("av1"))
  ok("AV1 family avif", isAv1FamilyCodec("avif"))
  ok("AV1 family h264 (false)", not isAv1FamilyCodec("h264"))
  ok("Encoder default extraction", ("ffmpeg -c:v libaom-av1 out.mp4"):match("%-c:v%s+(%S+)") == "libaom-av1")
  ok("Encoder template replacement",
    replaceEncoderInCommandTemplate("ffmpeg -c:v libaom-av1 out.mp4", "libsvtav1"):find("-c:v libsvtav1", 1, true) ~= nil)
  ok("AV1 libaom preset arg", getAv1PresetArgForEncoder("libaom-av1", 2, "medium") == "-cpu-used 2")
  ok("AV1 libsvt preset arg", getAv1PresetArgForEncoder("libsvtav1", 2, "medium") == "-preset 2")
  ok("AV1 rav1e preset arg", getAv1PresetArgForEncoder("librav1e", 2, "medium") == "-speed 2")

  -- —-- image dimension helpers —--
  local dimW, dimH = getImageDimensions({ OriginalWidth = 1920, OriginalHeight = 1080, Width = 960, Height = 540 })
  ok("Image dimensions prefer original", dimW == 1920 and dimH == 1080)
  dimW, dimH = getImageDimensions({ OriginalWidth = 0, OriginalHeight = 0, Width = 960, Height = 540 })
  ok("Image dimensions fallback to current", dimW == 960 and dimH == 540)
  dimW, dimH = getImageDimensions({ Value = { OriginalWidth = 1280, OriginalHeight = 720, Width = 640, Height = 360 } })
  ok("Image dimensions unwrap value", dimW == 1280 and dimH == 720)

  -- —-- splitBaseAndExt —--
  local b_, e_ = splitBaseAndExtension("/a/b.mp4")
  ok("splitBaseAndExt mp4", b_ == "/a/b" and e_ == ".mp4")
  local b0, e0 = splitBaseAndExtension("noext")
  ok("splitBaseAndExt noext", b0 == "noext" and e0 == ".png")
  local b1, e1 = splitBaseAndExtension(".hidden")
  ok("splitBaseAndExt .hidden", b1 == "" and e1 == ".hidden")
  local b2, e2 = splitBaseAndExtension("file.")
  ok("splitBaseAndExt trailing dot (no ext)", b2 == "file" and e2 == ".png")
  local b3, e3 = splitBaseAndExtension("a.tar.gz")
  ok("splitBaseAndExt double ext", b3 == "a.tar" and e3 == ".gz")

  -- —-- shouldShowSliderForPreset —--
  local h264 = {codec="h264"}
  local gif = {codec="gif"}
  ok("Slider CRF h264", shouldShowSliderForPreset("CRF", h264))
  ok("Slider CRF gif (false)", not shouldShowSliderForPreset("CRF", gif))
  ok("Slider MaxRate h264", shouldShowSliderForPreset("MaxRateMbps", h264))
  ok("Slider MaxRate vp9 (false)", not shouldShowSliderForPreset("MaxRateMbps", {codec="vp9"}))
  ok("Slider Keyframe gif (false)", not shouldShowSliderForPreset("KeyframeInterval", gif))

  -- —-- slider token parsing —--
  do
    local t = {}
    for n in string.gmatch("${S:CRF} and ${S:Width}", "%${S:([%a_][%w_]*)}") do t[n] = true end
    ok("SliderTokens CRF+Width", t.CRF and t.Width and not t.Height)
  end
  do
    local t = {}
    for n in string.gmatch("${AlphaFlattenFilterArg} and ${S:CRF}", "%${S:([%a_][%w_]*)}") do t[n] = true end
    if string.find("${AlphaFlattenFilterArg} and ${S:CRF}", "${AlphaFlattenFilterArg}", 1, true) then t.Width = true; t.Height = true end
    ok("SliderTokens filter token", t.Width and t.Height)
  end
  do
    local t = {}
    for n in string.gmatch("no tokens here", "%${S:([%a_][%w_]*)}") do t[n] = true end
    ok("SliderTokens none", next(t) == nil)
  end

  -- —-- IsValidShellPath extras —--
  ok("Valid \\r (rejected)", not isValidShellPath("a\rb"))
  ok("Valid unicode", isValidShellPath("/home/user/café.mp4"))
  ok("Valid long", isValidShellPath(string.rep("/a", 500)))
  ok("Invalid only meta", not isValidShellPath("$(`;)"))
  ok("Valid empty segment path", isValidShellPath("//a//b//c"))
  ok("Valid dot path", isValidShellPath("."))
  if IS_WINDOWS then ok("Invalid % on Windows", not isValidShellPath("a%b")) end

  -- —-- NormalizePath extras —--
  if not IS_WINDOWS then
    ok("NormalizePath doubleslash", normalizePath("a//b") == "a//b")
    ok("NormalizePath trailing", normalizePath("a/b/") == "a/b/")
  end

  -- —-- decodeJson —--
  local jval, jerr = decodeJson('{"x":1}')
  ok("decodeJson valid", jval ~= nil and jval.x == 1)
  local jbad, jbaderr = decodeJson("{bad}")
  ok("decodeJson invalid", jbad == nil and jbaderr ~= nil, tostring(jbaderr))

  -- —-- shell smoke tests —--
  local ep = runProcessCommand(IS_WINDOWS and "cmd /c echo hello" or "echo hello", {blocking=true})
  if ep then
    local eo = ep:read("*a"):gsub("%s+$","")
    ok("RunCommand echo", eo == "hello")
    ep:close()
  else
    ok("RunCommand echo", false, "spawn failed")
  end

  local wo, woExit = runCommandFullBlocking(IS_WINDOWS and "cmd /c echo ok" or "echo ok")
  ok("RunFullBlocking output", wo and wo:find("ok",1,true) ~= nil)
  ok("RunFullBlocking exit code 0", woExit == 0,
    "expected 0, got " .. tostring(woExit))

  -- Verify false command exits non-zero (shell returns 127 for "not found")
  local badOut, badExit = runCommandFullBlocking(IS_WINDOWS and "cmd /c nonexistent_cmd_xyz" or "nonexistent_cmd_xyz")
  ok("RunFullBlocking false command produces output", badOut ~= nil,
    "got nil (spawn failure), expected output string with exit code")
  if badOut ~= nil then
    ok("RunFullBlocking false command non-zero exit", badExit ~= 0,
      "expected non-zero, got " .. tostring(badExit) .. " output: " .. badOut:sub(1,80))
  end

  local lines = {}
  local st = runCommandPerLineBlocking(
    IS_WINDOWS and "echo L1 & echo L2" or "printf 'L1\\nL2\\n'",
    function(l) table.insert(lines,l) end)
  if st then while st() do end end
  ok("RunPerLine count", #lines == 2)
  if #lines == 2 then
    local l1 = lines[1]:gsub("^%s*(.-)%s*$", "%1")
    local l2 = lines[2]:gsub("^%s*(.-)%s*$", "%1")
    ok("RunPerLine L1", l1 == "L1")
    ok("RunPerLine L2", l2 == "L2")
  end

  -- —-- Pipe:read(n) —--
  local pp = runProcessCommand(IS_WINDOWS and "cmd /c echo abcd" or "echo abcd", {blocking=false})
  if pp then
    local c1 = pp:read(2); local c2 = pp:read(2)
    ok("Pipe:read(2)", c1 ~= nil and c2 ~= nil and #c1 == 2 and #c2 == 2)
    pp:close()
  end

  -- —-- RemoveDirectory —--
  local tmpDir = (IS_WINDOWS and (os.getenv("TEMP") or "C:\\Windows\\Temp") or "/tmp") .. getPathSeparator() .. "ffmpeg_saver_testdir"
  runCommandFullBlocking(IS_WINDOWS and string.format('rd /s /q "%s" 2>nul', tmpDir) or string.format('rm -rf "%s"', tmpDir))
  runCommandFullBlocking(IS_WINDOWS and string.format('if not exist "%s" mkdir "%s"', tmpDir, tmpDir) or string.format('mkdir -p "%s"', tmpDir))
  local existsOut = runCommandFullBlocking(IS_WINDOWS and string.format('if exist "%s\\" echo 1', tmpDir) or string.format('test -d "%s" && echo 1', tmpDir)) or ""
  if existsOut:find("1") then
    removeDirectory(tmpDir)
    local gone = runCommandFullBlocking(IS_WINDOWS and string.format('if exist "%s\\" echo 1', tmpDir) or string.format('test -d "%s" && echo 1', tmpDir)) or ""
    ok("RemoveDirectory", not gone:find("1"), "dir still exists after removal")
  else
    ok("RemoveDirectory", false, "could not create test dir: " .. tmpDir)
  end

  -- —-- findFfmpegPath —--
  local fp = findFfmpegPath()
  if fp then
    fuseLog("[info] FFmpeg found:", fp)
    local v = runCommandFullBlocking('"'..fp..'" -version 2>&1') or ""
    ok("ffmpeg works", v:lower():find("ffmpeg") ~= nil, fp)
  else
    fuseLog("[info] FFmpeg not found (OK)")
  end

  -- —-- error functions —--
  local ca = pcall(function() fuseError("intentional") end)
  ok("fuseError throws", not ca)
  local ca2 = pcall(function() fuseAssert(1==2,"fail") end)
  ok("fuseAssert false throws", not ca2)

  -- —-- data integrity —--
  ok("PRESETS count", #PRESET_DEFINITIONS == 11)
  ok("SLIDER_REG CRF", SLIDER_REGISTRY.CRF ~= nil)
  ok("RATE_CTRL count", #RATE_CONTROL_MODE_OPTIONS == 3)
  ok("H264_PRESET count", #H264_PRESET_OPTIONS == 9)
  ok("PRORES count", #PRORES_PROFILE_OPTIONS == 6)
  ok("Parallel array AV1_SIZE", #AV1_PRESET_VALUES == #H264_PRESET_OPTIONS,
    "AV1 ("..#AV1_PRESET_VALUES..") vs H264 ("..#H264_PRESET_OPTIONS..")")
  ok("Parallel array VP9_SIZE", #VP9_CPU_USED_VALUES == #H264_PRESET_OPTIONS,
    "VP9 ("..#VP9_CPU_USED_VALUES..") vs H264 ("..#H264_PRESET_OPTIONS..")")

  -- —-- getPresetDefinitionByIndex —--
  local p1 = getPresetDefinitionByIndex(1)
  ok("preset index 1 codec", p1 and p1.codec == "h264")
  local p9 = getPresetDefinitionByIndex(9)
  ok("preset index 9 codec", p9 and p9.codec == "avif")

  local p999 = getPresetDefinitionByIndex(999)
  ok("preset index out-of-bounds returns first", p999 and p999.codec == "h264")

  -- —-- buildProgressHtml edge cases —--
  local bp0 = buildProgressHtml(0, 0, 0)
  ok("buildProgressHtml 0/0", bp0 and #bp0 > 0 and bp0:find("0%%") ~= nil)
  local bp1 = buildProgressHtml(1, 10, 10)
  ok("buildProgressHtml complete", bp1 and bp1:find("Frame 10 / 10") ~= nil)
  local bpHalf = buildProgressHtml(0.5, nil, nil, "encoding")
  ok("buildProgressHtml status text", bpHalf and bpHalf:find("encoding") ~= nil)
  local bpClamp = buildProgressHtml(-0.1, 0, 0)
  ok("buildProgressHtml negative clamp", bpClamp and bpClamp:find("0%%") ~= nil)

  -- —-- shouldShowSliderForPreset unknown token —--
  ok("Slider unknown token returns true", shouldShowSliderForPreset("BogusToken", {codec="h264"}))
  ok("Slider unknown token prores", shouldShowSliderForPreset("BogusToken", {codec="prores"}))

  -- —-- decodeJson edge cases —--
  local jnil, jnilErr = decodeJson(nil)
  ok("decodeJson nil fails", jnil == nil and jnilErr ~= nil, tostring(jnilErr))
  local jempty, jemptyErr = decodeJson("")
  ok("decodeJson empty fails", jempty == nil and jemptyErr ~= nil, tostring(jemptyErr))
  local jws, jwsErr = decodeJson("   ")
  ok("decodeJson whitespace fails", jws == nil and jwsErr ~= nil, tostring(jwsErr))

  -- —-- Sleep smoke test (must not crash) —--
  local sleepOk = pcall(sleep, 0)
  ok("Sleep(0) no crash", sleepOk)

  -- —-- RunPerLineBlocking with no output —--
  local noOutLines = {}
  local noOutStep = runCommandPerLineBlocking(
    IS_WINDOWS and "cd ." or "true",
    function(l) table.insert(noOutLines, l) end)
  if noOutStep then while noOutStep() do end end
  ok("RunPerLineBlocking no output = 0 lines", #noOutLines == 0,
    "got " .. #noOutLines .. " lines")

  -- —-- Pipe:read("*a") after partial read —--
  local pp2 = runProcessCommand(IS_WINDOWS and "cmd /c echo 1234567890" or "echo 1234567890", {blocking=false})
  if pp2 then
    local c3 = pp2:read(5)
    local rest = pp2:read("*a")
    rest = rest and rest:gsub("%s+$","") or ""
    ok("Pipe:read(5) then read(*a)", c3 ~= nil and #c3 == 5 and rest ~= nil and #rest > 0,
      "first 5: '" .. tostring(c3) .. "', rest: '" .. tostring(rest) .. "'")
    pp2:close()
  end

  ok("SLIDER_TOKEN_MAP table", type(sliderTokenMap) == "table")

  fuseLog(string.format("========== SELF-TEST END: %d/%d passed ==========", p, p+f))
  if f > 0 then fuseLog("SELF-TEST FAILED:", f, "tests") end
end

