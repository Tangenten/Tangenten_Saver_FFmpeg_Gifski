-- region FFI subprocess & platform layer

local ffi = require("ffi")
local json = require("dkjson")

local PLUGIN_NAME    = "Saver (FFmpeg & Gifski)"
local PLUGIN_VERSION = "0.8.0"

local FUSE_LOG_ENABLED = false
local FUSE_STARTUP_TESTS_ENABLED = false

local function fuseLog(...)
  if not FUSE_LOG_ENABLED then return end
  print("[FFMPEGSaver]", ...)
end

-- halts execution
local function fuseError(...)
  error("[FFMPEGSaver] [ERROR] " .. table.concat({...}, " "), 2)
end

-- Assert a condition; halts with fuseError on failure.
local function fuseAssert(condition, ...)
  if not condition then
    fuseError(...)
  end
end

local function decodeJson(jsonText)
  if not jsonText or type(jsonText) ~= "string" or #jsonText == 0 then
    return nil, "jsonText is nil or empty"
  end
  local decodedValue, _, decodeError = json.decode(jsonText, 1, nil)
  return decodedValue, decodeError
end

-- ============================================================================
-- FFI & cross-platform subprocess execution
-- ============================================================================

local IS_WINDOWS = package.config:sub(1, 1) == "\\"

-- Platform-specific FFI backends ----

local _K32, _libc
local _CreatePipe, _CreateProcessA, _CloseHandle, _ReadFile
local _WaitForSingleObject, _GetExitCodeProcess, _SetHandleInformation, _GetStdHandle
local _pipe, _fork, _dup2, _c_close, _execl, _c_exit, _c_read, _waitpid
local _WIFEXITED, _WEXITSTATUS, _WNOHANG

if IS_WINDOWS then
  ffi.cdef[[
    typedef void* HANDLE;
    typedef unsigned long DWORD;
    typedef int BOOL;
    typedef unsigned short WORD;
    typedef struct {
      DWORD nLength;
      void* lpSecurityDescriptor;
      BOOL bInheritHandle;
    } SECURITY_ATTRIBUTES;
    typedef struct {
      DWORD cb;
      char* lpReserved;
      char* lpDesktop;
      char* lpTitle;
      DWORD dwX; DWORD dwY;
      DWORD dwXSize; DWORD dwYSize;
      DWORD dwXCountChars; DWORD dwYCountChars;
      DWORD dwFillAttribute;
      DWORD dwFlags;
      WORD wShowWindow;
      WORD cbReserved2;
      void* lpReserved2;
      HANDLE hStdInput;
      HANDLE hStdOutput;
      HANDLE hStdError;
    } STARTUPINFO;
    typedef struct {
      HANDLE hProcess;
      HANDLE hThread;
      DWORD dwProcessId;
      DWORD dwThreadId;
    } PROCESS_INFORMATION;
    BOOL CreatePipe(HANDLE* hReadPipe, HANDLE* hWritePipe, SECURITY_ATTRIBUTES* lpPipeAttributes, DWORD nSize);
    BOOL CreateProcessA(const char* lpApplicationName, char* lpCommandLine, void* lpProcessAttributes, void* lpThreadAttributes, BOOL bInheritHandles, DWORD dwCreationFlags, void* lpEnvironment, const char* lpCurrentDirectory, STARTUPINFO* lpStartupInfo, PROCESS_INFORMATION* lpProcessInformation);
    BOOL CloseHandle(HANDLE hObject);
    BOOL ReadFile(HANDLE hFile, void* lpBuffer, DWORD nNumberOfBytesToRead, DWORD* lpNumberOfBytesRead, void* lpOverlapped);
    DWORD WaitForSingleObject(HANDLE hHandle, DWORD dwMilliseconds);
    BOOL GetExitCodeProcess(HANDLE hProcess, DWORD* lpExitCode);
    BOOL SetHandleInformation(HANDLE hObject, DWORD dwMask, DWORD dwFlags);
    HANDLE GetStdHandle(DWORD nStdHandle);
    void Sleep(DWORD dwMilliseconds);
    int CreateDirectoryA(const char* lpPathName, void* lpSecurityAttributes);
  ]]

  _K32 = ffi.load("kernel32")
else
  ffi.cdef[[
    typedef unsigned int pid_t;
    int pipe(int pipefd[2]);
    pid_t fork(void);
    int dup2(int oldfd, int newfd);
    int close(int fd);
    int execl(const char *path, const char *arg0, ...);
    void _exit(int status);
    long read(int fd, void *buf, unsigned long count);
    pid_t waitpid(pid_t pid, int *status, int options);
    int usleep(unsigned long usec);
    int mkdir(const char *pathname, unsigned int mode);
  ]]

  _libc = ffi.C
  _WNOHANG = 1
  _WIFEXITED  = function(s) return bit.band(s, 0x7f) == 0 end
  _WEXITSTATUS = function(s) return bit.rshift(bit.band(s, 0xff00), 8) end
end

----------------------------------------------------------------

-- Spawn a child process. Returns {handle, proc_handle} or nil, err.
local function _spawn(cmd, showTerminal)
  if IS_WINDOWS then
    local sa = ffi.new("SECURITY_ATTRIBUTES")
    sa.nLength = ffi.sizeof("SECURITY_ATTRIBUTES")
    sa.bInheritHandle = 1

    local hRead = ffi.new("HANDLE[1]")
    local hWrite = ffi.new("HANDLE[1]")
    if _K32.CreatePipe(hRead, hWrite, sa, 65536) == 0 then
      return nil, "CreatePipe failed"
    end

    _K32.SetHandleInformation(hRead[0], 1, 0) -- HANDLE_FLAG_INHERIT

    local si = ffi.new("STARTUPINFO")
    si.cb = ffi.sizeof("STARTUPINFO")
    si.dwFlags = 0x00000100 -- STARTF_USESTDHANDLES
    si.hStdOutput = hWrite[0]
    si.hStdError  = hWrite[0]
    si.hStdInput  = _K32.GetStdHandle(-10) -- STD_INPUT_HANDLE

    local pi = ffi.new("PROCESS_INFORMATION")
    -- Wrap in cmd /c so built-ins (mkdir, del, rd, if) and shell syntax (2>&1) work.
    local wrapped = "cmd /c " .. cmd
    local cmdBuf = ffi.new("char[?]", #wrapped + 1)
    ffi.copy(cmdBuf, wrapped)

    local flags = showTerminal and 0 or 0x08000000 -- CREATE_NO_WINDOW
    if _K32.CreateProcessA(nil, cmdBuf, nil, nil, 1, flags, nil, nil, si, pi) == 0 then
      _K32.CloseHandle(hRead[0])
      _K32.CloseHandle(hWrite[0])
      return nil, "CreateProcess failed"
    end

    _K32.CloseHandle(hWrite[0])
    return { handle = hRead[0], proc = pi.hProcess, thread = pi.hThread }
  else
    -- Unix: fork+exec
    local fds = ffi.new("int[2]")
    if _libc.pipe(fds) ~= 0 then
      return nil, "pipe failed"
    end

    local pid = _libc.fork()
    if pid < 0 then
      _libc.close(fds[0]); _libc.close(fds[1])
      return nil, "fork failed"
    end

    if pid == 0 then
      -- Child: redirect stdout+stderr → pipe, exec /bin/sh -c cmd
      _libc.close(fds[0])
      _libc.dup2(fds[1], 1)
      _libc.dup2(fds[1], 2)
      _libc.close(fds[1])
      _libc.execl("/bin/sh", "sh", "-c", cmd, nil)
      _libc._exit(127)
    end

    _libc.close(fds[1])
    return { handle = fds[0], proc = pid }
  end
end

-- Read raw bytes from the child's stdout. Returns string or nil at EOF.
local function _childRead(info)
  if IS_WINDOWS then
    local buf = ffi.new("char[65536]")
    local nread = ffi.new("DWORD[1]")
    if _K32.ReadFile(info.handle, buf, 65536, nread, nil) == 0 or nread[0] == 0 then
      return nil
    end
    return ffi.string(buf, nread[0])
  else
    local buf = ffi.new("char[65536]")
    local n = _libc.read(info.handle, buf, 65536)
    if n <= 0 then return nil end
    return ffi.string(buf, n)
  end
end

-- Wait for child exit. timeout: true = blocking INFINITE, false = non-blocking poll.
-- Returns exit code, or nil if still running (non-blocking only).
local function _childWait(info, blocking)
  if IS_WINDOWS then
    local ms = blocking and 0xFFFFFFFF or 0
    local r = _K32.WaitForSingleObject(info.proc, ms)
    if r == 0x00000102 then return nil end -- WAIT_TIMEOUT
    local code = ffi.new("DWORD[1]")
    _K32.GetExitCodeProcess(info.proc, code)
    return code[0]
  else
    local status = ffi.new("int[1]")
    local opts = blocking and 0 or _WNOHANG
    local r = _libc.waitpid(info.proc, status, opts)
    if r == 0 then return nil end
    if r < 0 then
      fuseLog("[_childWait] waitpid error for pid", info.proc)
      return nil
    end
    if _WIFEXITED(status[0]) then return _WEXITSTATUS(status[0]) end
    local sig = bit.band(status[0], 0x7f)
    fuseLog("[_childWait] Process", info.proc, "terminated by signal", sig)
    return 128 + sig
  end
end

-- Release all OS resources (do not wait — wait is separate).
local function _childCleanup(info)
  if IS_WINDOWS then
    _K32.CloseHandle(info.handle)
    _K32.CloseHandle(info.proc)
    _K32.CloseHandle(info.thread)
  else
    _libc.close(info.handle)
  end
end

-- ============================================================================
-- Pipe I/O object (wraps platform process handles)
-- ============================================================================

local PIPE = {}
PIPE.__index = PIPE

function PIPE:read(format)
  if format == "*a" then
    local parts = {}
    if #self._buf > 0 then
      parts[1] = self._buf
      self._buf = ""
    end
    while true do
      local chunk = _childRead(self._info)
      if not chunk then break end
      parts[#parts + 1] = chunk
    end
    if #parts > 0 then return table.concat(parts) end
    return nil
  elseif format == "*l" then
    while true do
      local nl = self._buf:find("\n", 1, true)
      if nl then
        local line = self._buf:sub(1, nl - 1)
        if line:sub(-1) == "\r" then line = line:sub(1, -2) end
        self._buf = self._buf:sub(nl + 1)
        return line
      end
      local chunk = _childRead(self._info)
      if not chunk then
        if #self._buf > 0 then
          local line = self._buf
          self._buf = ""
          return line
        end
        return nil
      end
      self._buf = self._buf .. chunk
    end
  elseif type(format) == "number" and format > 0 then
    while #self._buf < format do
      local chunk = _childRead(self._info)
      if not chunk then break end
      self._buf = self._buf .. chunk
    end
    if #self._buf == 0 then return nil end
    local n = math.min(format, #self._buf)
    local result = self._buf:sub(1, n)
    self._buf = self._buf:sub(n + 1)
    return result
  end
  return nil
end

function PIPE:wait()
  if self._exitCode ~= nil then return self._exitCode end
  self._exitCode = _childWait(self._info, true) -- blocking
  return self._exitCode
end

function PIPE:close()
  if self._closed then return end
  self._closed = true
  if self._exitCode == nil then
    self:wait()
  end
  _childCleanup(self._info)
end

function PIPE:lines()
  local p = self
  return function()
    return p:read("*l")
  end
end

-- The eof property: true when process exited AND all output consumed.
-- Used by RunPerLineBlocking to know when to call on_done.
function PIPE:iseof()
  if self._buf ~= "" then return false end
  if self._exitCode ~= nil then return true end
  -- Check if process exited
  self._exitCode = _childWait(self._info, false) -- non-blocking poll
  if self._exitCode ~= nil then return true end
  return false
end

-- ============================================================================
-- RunCommand: cross-platform subprocess execution
-- ============================================================================
--
-- Usage:
--   local ok, pipe = RunCommand(cmd, opts)
--   if pipe then
--     for line in pipe:lines() do ... end
--     pipe:close()
--   end
--
-- opts:
--   showTerminal = false    Show a terminal window? (Windows: new console; Unix: terminal emulator)
--   blocking     = true     Wait for process to finish before returning?
--
-- Returns: pipe object, or nil, error

local function runProcessCommand(cmd, opts)
  opts = opts or {}
  local blocking = (opts.blocking ~= nil) and opts.blocking or true

  local info, err = _spawn(cmd, opts.showTerminal)
  if not info then return nil, err end

  local p = setmetatable({
    _info     = info,
    _buf      = "",
    _exitCode = nil,
    _closed   = false,
  }, PIPE)

  if blocking then p:wait() end
  return p
end

-- ============================================================================
-- Path & shell utilities
-- ============================================================================


-- Capture full stdout/stderr, return as string plus exit code.
-- IMPORTANT: spawns with blocking=false, reads pipe FIRST, then waits for exit.
-- This avoids a deadlock when the child writes more than the pipe buffer
-- capacity (64KB on Linux) while the parent blocks on waitpid.
-- Returns (output_string, exit_code) on success, or (nil, nil) on spawn failure.
local function runCommandFullBlocking(cmd)
    local pipe, err = runProcessCommand(cmd, {blocking = false})
    if not pipe then
      fuseLog("[RunFullBlocking] Failed to spawn: " .. tostring(err) .. " | cmd: " .. cmd)
      return nil, nil
    end
    -- Drain pipe BEFORE waiting — prevents pipe-buffer deadlock.
    -- read("*a") blocks on read() until EOF (child closes pipe on exit),
    -- naturally draining the buffer as data arrives.
    local rawOut = pipe:read("*a")
    local exitCode = pipe:wait()
    pipe:close()
    local out = rawOut or ""
    local displayOut = #out > 200 and out:sub(1, 200) .. "..." or out
    if #displayOut == 0 then displayOut = "(empty)" end
    fuseLog("[RunFullBlocking] exit:", exitCode, "| out:", displayOut, "| cmd:", cmd)
    return out, exitCode
end

-- Run command, deliver output line-by-line via on_line / on_done callbacks.
-- Returns a step() function: call it until it returns false.
local function runCommandPerLineBlocking(cmd, on_line, on_done)
    fuseLog(cmd)
    local pipe, err = runProcessCommand(cmd, {blocking = false})
    if not pipe then
      fuseLog("[RunPerLineBlocking] Failed: " .. tostring(err))
      if on_done then on_done() end
      return nil
    end

    local function step()
      local line = pipe:read("*l")
      if line then
        if on_line then on_line(line) end
        return true
      end
      if pipe:iseof() then
        pipe:close()
        if on_done then on_done() end
        return false
      end
      return true
    end

    return step
end

-- Cross-platform path separator
local function getPathSeparator()
    return IS_WINDOWS and "\\" or "/"
end

-- Compute the number of zero-padded digits needed for frame filenames.
-- Returns at least 4 (backward compatible with existing %04d formats).
-- Grows dynamically for sequences with more than 9999 frames so that
-- lexicographic sorting matches numeric order.
local function getFrameWidth(maxFrame)
  return math.max(4, math.floor(math.log10(math.max(maxFrame, 1))) + 1)
end

-- Build a frame file path (cross-platform separator).
-- frameWidth: number of zero-padded digits (default 4 for backward compat).
local function buildFramePath(basePath, frameFolder, frame, sequenceExtension, isPngSequence, frameWidth)
    frameWidth = frameWidth or 4
    local fmt = "%s_%0" .. frameWidth .. "d%s"
    if isPngSequence then
        return string.format(fmt, basePath, frame, sequenceExtension)
    end
    local sep = getPathSeparator()
    return string.format("%s" .. sep .. "%0" .. frameWidth .. "d%s", frameFolder, frame, sequenceExtension)
end

-- Normalize paths for cross-platform (forward slashes → backslashes on Windows)
local function normalizePath(path)
    if IS_WINDOWS then path = path:gsub("/", "\\") end
    return path
end



-- Remove a directory (cross-platform)
local function removeDirectory(path)
    local cmd = IS_WINDOWS
      and string.format('rd /s /q "%s"', path)
      or  string.format('rm -rf "%s"', path)
    local result, exitCode = runCommandFullBlocking(cmd)
    if result == nil then
      fuseLog("[RemoveDirectory] Failed to spawn removal for: " .. path)
      return
    end
    if exitCode == nil then
      fuseLog("[RemoveDirectory] Could not get exit code from removal of '" .. path .. "'")
    elseif exitCode ~= 0 then
      fuseLog("[RemoveDirectory] Removal of '" .. path .. "' returned exit code " .. exitCode .. " (output: " .. result:sub(1, 200) .. ")")
    end
end

-- Cross-platform sleep (seconds)
local function sleep(seconds)
  if IS_WINDOWS then
    _K32.Sleep(seconds * 1000)
  else
    _libc.usleep(seconds * 1000000)
  end
end

-- Get file size in MB as a formatted string (e.g. "12.3 MB").
-- Returns nil if the file does not exist.
local function getFileSizeMB(path)
  local f = io.open(path, "r")
  if not f then return nil end
  local size = f:seek("end")
  f:close()
  if size <= 0 then return nil end
  return string.format("%.1f MB", size / (1024 * 1024))
end

-- Get info about a frame folder: count of PNG files and total size as string.
-- Returns (count, size_string) or (nil, nil) if folder doesn't exist.
local function getFrameFolderInfo(folderPath)
  local f = io.open(folderPath, "r")
  if not f then return nil, nil end
  f:close()

  local count = 0
  local totalSize = 0
  local handle = io.popen(IS_WINDOWS
    and string.format('dir /a-d /b "%s\\*.png" 2>nul', folderPath)
    or string.format('find "%s" -maxdepth 1 -name "*.png" -type f 2>/dev/null', folderPath))
  if handle then
    for line in handle:lines() do
      count = count + 1
      -- Try to get size too; on Unix `ls -l` can give size in a second pass,
      -- but for simplicity just count and do a second pass for size.
    end
    handle:close()
  end

  -- Get total size via du/dir
  local sizeStr = nil
  if count > 0 then
    local sizeCmd = IS_WINDOWS
      and string.format('cmd /c for %%f in ("%s\\*.png") do set /a total+=%%~zf & echo !total!', folderPath)
      or string.format('du -sb "%s" 2>/dev/null | cut -f1', folderPath)
    local out = runCommandFullBlocking(sizeCmd)
    if out then
      local bytes = tonumber(out:match("(%d+)"))
      if bytes then
        sizeStr = string.format("%.1f MB", bytes / (1024 * 1024))
      end
    end
  end

  return count, sizeStr
end

-- Remove the frame folder for a given base path.
-- Returns a human-readable status string.
local function clearFrameFolder(basePath)
  local frameFolder = basePath .. "_frames"
  local count, _ = getFrameFolderInfo(frameFolder)
  if count and count > 0 then
    removeDirectory(frameFolder)
    return "Cleared " .. count .. " frame(s)"
  end
  return "No frames to clear"
end

-- Check whether a cancel has been requested.  Uses two independent mechanisms
-- because NotifyChanged and Process run in separate Lua states (globals set
-- in one are NOT visible in the other):
--   1. self:GetData("cancelRequested") — set by NotifyChanged via SetData
--   2. InCancelBtn:GetValue(req).Value — the button's own value is set by
--      Fusion's UI even before NotifyChanged fires
local function isCancelRequested(self_, req)
  return (self_ and self_:GetData("cancelRequested")) or
         (InCancelBtn and req and InCancelBtn:GetValue(req).Value > 0.5)
end

-- Refresh the output file size label.
local function refreshOutputFileSize(basePath, ext)
  if not InOutputFileSize then return end
  local outputFile = basePath .. ext
  local sizeStr = getFileSizeMB(outputFile)
  if sizeStr then
    InOutputFileSize:SetAttrs({ LINKS_Name = "<span style='color:#b0b8c0;'>Output: <b>" .. sizeStr .. "</b></span>" })
  else
    InOutputFileSize:SetAttrs({ LINKS_Name = "<span style='color:#8a94a0;'>Output: —</span>" })
  end
end

-- Refresh the frame folder status label.
local function refreshFrameStatus(basePath)
  if not InFrameStatus then return end
  local frameFolder = basePath .. "_frames"
  local count, sizeStr = getFrameFolderInfo(frameFolder)
  if count and count > 0 then
    InFrameStatus:SetAttrs({ LINKS_Name = "<span style='color:#b0b8c0;'>Frames: <b>" .. count .. "</b> (" .. (sizeStr or "?") .. ")</span>" })
    InClearFramesBtn:SetAttrs({ LINKS_Name = "Clear " .. count .. " Frames" })
  else
    InFrameStatus:SetAttrs({ LINKS_Name = "<span style='color:#8a94a0;'>Frames: —</span>" })
    InClearFramesBtn:SetAttrs({ LINKS_Name = "Clear Exported Frames" })
  end
end

-- Validate a path before using it in shell commands.
-- Returns true or false + reason.
--
-- Shell metacharacters that are interpreted even inside double-quoted
-- strings: $ ` \ " ! and control characters (\n, \r).
-- We also reject | ; & as a defense-in-depth measure for the rare case
-- a path might appear outside quotes.
local function isValidShellPath(path)
    if not path or path == "" then
        return false, "path is empty"
    end
    -- Reject $ ` \ " ! | ; & and control characters.
    -- Inside a double-quoted shell string these expand ($ ` \ " !) or
    -- could break quoting (\ "). | ; & are rejected as defense-in-depth.
    -- Note: double-quoted Lua string so \\n and \\r are actual control chars.
    if path:match("[$`\\\"!|;&\n\r]") then
        return false, "path contains shell metacharacters"
    end
    if IS_WINDOWS then
        -- % expands environment variables in cmd.exe even inside " quotes.
        -- < > are redirection operators; " would break quoting.
        if path:match('["<>%%]') then
            return false, "path contains invalid Windows characters"
        end
    end
    return true
end

